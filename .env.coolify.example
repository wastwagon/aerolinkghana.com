AUTH_URL=https://aerolinkghana.com

NEXT_PUBLIC_APP_URL=https://aerolinkghana.com
NEXT_PUBLIC_PHONE=0555207204
NEXT_PUBLIC_WHATSAPP_NUMBER=233555207204
NEXT_PUBLIC_ADDRESS=Burma Camp, Accra, Ghana
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://www.google.com/maps/search/?api=1&query=AeroLink+Ghana+Burma+Camp+Accra

